[2.2,"o","cli-ref$ psql --help 2>&1 | sed -n '1,14p'\r\n"]
[2.55,"o","psql is the PostgreSQL interactive terminal.\r\n\r\nUsage:\r\n  psql [OPTION]... [DBNAME [USERNAME]]\r\n\r\nGeneral options:\r\n  -c, --command=COMMAND    run only single command (SQL or internal) and exit\r\n  -d, --dbname=DBNAME      database name to connect to (default: \"lukaszbartoszcze\")\r\n  -f, --file=FILENAME      execute commands from file, then exit\r\n  -l, --list               list available databases, then exit\r\n  -v, --set=, --variable=NAME=VALUE\r\n                           set psql variable NAME to VALUE\r\n                           (e.g., -v ON_ERROR_STOP=1)\r\n  -V, --version            output version information, then exit\r\n"]
[5.1,"o","cli-ref$ psql --definitely-invalid-option 2>&1 | sed -n '1,14p'\r\n"]
[5.45,"o","/usr/lib/postgresql/16/bin/psql: unrecognized option '--definitely-invalid-option'\r\npsql: hint: Try \"psql --help\" for more information.\r\n[exit status 1]\r\n"]
