[2.549615, "o", "UID] [--from YYYY-MM-DD --to YYYY-MM-DD]\r\n  oko-cli auto-goals classify-missing [--limit N] [--sidecar PATH]\r\n  oko-cli auto-goals rebuild-window --user-id UUID --from YYYY-MM-DD --to YYYY-MM-DD [--org-id UUID] [--pace MS] [--limit N] [--provider-subscription] [--window-only] [--indexed] [--sidecar PATH]\r\n  oko-cli auto-goals reconcile-today [--force]\r\n  oko-cli auto-goals truth [--days N] [--all] [--until ISO]\r\n  oko-cli auto-goals review-recompute --run-id SHA256 --sidecar PATH [--merge SURVIVOR_ID=OTHER_ID[,OTHER_ID...] ...] [--keep-duplicates GROUP_ID ...] [--output PATH]\r\n  oko-cli auto-goals apply-recompute --run-id SHA256 [--sidecar PATH]\r\n  oko-cli auto-goals rollback-recompute --run-id SHA256 [--sidecar PATH]\r\n  oko-cli goals extract [--file PATH] [--limit N]\r\n  oko-cli telemetry [--limit N] [--days N]\r\n  oko-cli pricing refresh [--force]\r\n  oko-cli subscription-router [--json] [--agent-id ID] [--agents A,B] [--config PATH]\r\n  oko-cli context snapshot [--anchors PATH] [--python PATH] [--bridge PATH]\r"]
[2.549626, "o", "\r\n  oko-cli context refresh-slack [--full] [--channel-page-limit N] [--max-rows N] [--output PATH]\r\n  oko-cli context search-slack --query TEXT [--source api|cache|both] [--count N]\r\n  oko-cli context diagnose-goals\r\n  oko-cli context host-exec --command CMD [--cwd PATH] [--timeout SEC]\r\n  oko-cli transcripts reindex [--path FILE] [--db PATH] [--max-parses N] [--json]\r\n  oko-cli hooks install [--preview] [--no-backup] [--oko-root PATH] [--install-root PATH]\r\n  oko-cli hooks publish [--org-id UUID] [--table NAME] [--bundle KEY]\r\n  oko-cli hooks pull [--preview] [--org-id UUID] [--table NAME] [--bundle KEY] [--oko-root PATH]\r\n  oko-cli suggestions {tick|reply|costs} [--channel ID] [--trigger-ts TS]\r\n  oko-cli pty attach --socket PATH [--session ID --control PATH]\r\n  oko-cli pty relay-attach --relay URL --session ID\r\n  oko-cli pty relay-publish --relay URL --session ID --socket PATH [--control PATH]\r\n  oko-cli pty broker-serve [--socket PATH]\r\n  oko-cli pty broker-ensure\r\n  oko-cli pty broker-list [--socket PATH"]
[2.549644, "o", "]\r\n  oko-cli pty broker-external-list\r\n  oko-cli pty broker-spawn --executable PATH [--cwd DIR] [-- ARG...]\r\n  oko-cli pty broker-adopt-external [--target latest_codex|PID|SESSION] [--text TEXT] [--no-submit] [--socket PATH]\r\n  oko-cli pty broker-send --session ID --text TEXT [--socket PATH]\r\n  oko-cli pty broker-repaint --session ID [--socket PATH]\r\n  oko-cli pty broker-terminate --session ID [--socket PATH]\r\n"]
