[5.293926, "o", "Error: unknown option: --wisent-reference-probe\r\nUsage:\r\n  jeden [--cwd path] [--model name] [--max-tokens n] [--allow-write] [--allow-command] [--yolo|--auto-approve] [--max-steps n]\r\n  jeden --version | -V\r\n  jeden run \"task\" [--json] [--model-only] [--cwd path] [--model name] [--max-tokens n] [--allow-write] [--allow-command] [--yolo|--auto-approve] [--max-steps n]\r\n  jeden pursue \"rough objective\" [--json] [--cwd path] [--model name] [--allow-write] [--allow-command] [--yolo|--auto-approve] [--max-steps n]\r\n  jeden rpc              serve newline-delimited JSON RPC on stdio\r\n  jeden headless <addr> <server-cert.pem> <server-key.pem> <client-ca.pem> <identity-map.json> [revoked-serials.txt]\r\n  jeden acp              serve ACP on stdio\r\n  jeden sessions [limit]\r\n  jeden show <session-id-or-path>\r\n  jeden export <session-id-or-path> [output.json]\r\n  jeden artifacts <session-id-or-path>\r\n  jeden artifact <session-id-or-path> <name> [output]\r\n  jeden config [list|path|get <key>|set <key> <value>|reset <key>] [-"]
[5.293949, "o", "-json] [--cwd path]\r\n  jeden doctor [--json] [--cwd path]\r\n  jeden conformance [--json] [--cwd path]\r\n  jeden probierz [args...] — run Probierz discovery, evidence, and gate commands for Jeden\r\n  jeden capabilities [--json] [--cwd path]\r\n  jeden completions <bash|zsh|fish>\r\n  jeden worktree [list|clear] [--dry-run] [--json] [--cwd path]\r\n  jeden token [--list] [--reveal] [--json] — print the agent Brama credential (redacted by default)\r\n  jeden stats [--json|--summary|--serve [--port N]] — usage/quota snapshot or local web dashboard\r\n  jeden gallery [--theme NAME|--all] [--color] — render TUI components across themes (dev tool)\r\n\r\n  jeden roadmap <list|show|add|drop|start|implemented|block|pass|status|depends|undepends|graph|acceptance|check|render|work> [args] [--json] [--cwd path]\r\n\r\nSlash commands:\r\n  /login [provider]      inspect entitlements-router login/reauth plan\r\n  /logout [provider]     show Weles-managed logout ownership\r\n  /settings              show auth and provider status\r\n  /setup    "]
