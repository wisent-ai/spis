#!/usr/bin/env python3
"""spis-serve — loopback HTTP/JSON backend for the Spis desktop app.

The desktop app spawns this once (`python3 bin/spis-serve --port 0`) and talks
to it over 127.0.0.1 HTTP — it never builds argv for the spis subcommands.
On bind, exactly one line lands on stdout:

    {"ready":true,"port":<number>}

After that line stdout carries no protocol traffic; every failure is an HTTP
response. All endpoints live under /v1 and every handler runs the same spis
subcommand the CLI would run — no parallel implementation.

Errors before a stream starts are non-2xx with body {"error": "<sentence>"}.
Every operation streams NDJSON (Content-Type: application/x-ndjson):

    {"type":"log","stream":"stdout"|"stderr","chunk":"..."}  (zero or more)
    {"type":"result","status":0,"json":{...}}                (exactly one, last)

`status` mirrors the exit code the subcommand would have had; on failure
`json` is {"error": "<the tool's own refusal sentence, verbatim>"}.

Endpoints:

    GET  /v1/health
    POST /v1/catalogs-check     {} — consistency gate over index and records
    POST /v1/drift              {} — upstream README and URL drift report
    POST /v1/verify             {} — measure stored evidence (dry run)
    POST /v1/capture-plan       {} — what own-product capture can run here
    POST /v1/guidelines         {"slug": "landing-page-examples"}
    POST /v1/reference-add      {"slug", "name", "sourceUrl", "category",
                                 "selectionNote", "visual"}
    POST /v1/reference-remove   {"slug", "number": 3, "force": true}

Standard library only; no third-party dependencies.
"""

from __future__ import annotations

import argparse
import json
import os
import queue
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MAX_BODY_BYTES = 1024 * 1024

# One streamed job at a time: each job's log events stay on its own response.
JOB_LOCK = threading.Lock()


class ServeError(Exception):
    """An error that becomes a non-2xx {"error": sentence} envelope."""

    def __init__(self, status: int, message: str):
        super().__init__(message)
        self.status = status


def bad_request(message: str) -> ServeError:
    return ServeError(400, message)


def spis_binary() -> Path:
    for candidate in (ROOT / "target" / "release" / "spis", ROOT / "target" / "debug" / "spis"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    raise ServeError(500, "The corpus tools are not built in this checkout.")


def require_text(body: dict, key: str, sentence: str) -> str:
    value = body.get(key)
    if not isinstance(value, str) or not value.strip():
        raise bad_request(sentence)
    return value.strip()


def operation_argv(name: str, body: dict) -> list[str]:
    """Map one endpoint to the exact spis subcommand invocation it replaces."""
    if name == "catalogs-check":
        return ["generate-example-catalogs", "--check"]
    if name == "drift":
        return ["check-upstream-drift"]
    if name == "verify":
        return ["verify-reference-evidence"]
    if name == "capture-plan":
        return ["capture-wisent-references", "--list"]
    if name == "guidelines":
        slug = require_text(body, "slug", "deriving guidelines requires a catalog slug")
        return ["guidelines", slug]
    if name == "reference-add":
        slug = require_text(body, "slug", "adding a record requires a catalog slug")
        record_name = require_text(body, "name", "adding a record requires a name")
        source_url = require_text(body, "sourceUrl", "adding a record requires a source URL")
        category = require_text(body, "category", "adding a record requires a category")
        note = require_text(body, "selectionNote", "adding a record requires a selection note")
        visual = require_text(body, "visual", "adding a record requires an image path")
        return [
            "reference-record", "add", slug,
            "--name", record_name,
            "--source-url", source_url,
            "--category", category,
            "--selection-note", note,
            "--visual", visual,
        ]
    if name == "reference-remove":
        slug = require_text(body, "slug", "removing a record requires a catalog slug")
        number = body.get("number")
        if not isinstance(number, int) or isinstance(number, bool) or number < 1:
            raise bad_request("removing a record requires its number")
        argv = ["reference-record", "remove", slug, str(number)]
        if body.get("force"):
            argv.append("--force")
        return argv
    raise ServeError(404, f"unknown endpoint: POST /v1/{name}")


def refusal_sentence(stderr_text: str) -> str:
    """The tool's own refusal: its last stderr line, without the log prefix."""
    lines = [line.strip() for line in stderr_text.splitlines() if line.strip()]
    if not lines:
        return "The operation failed without reporting a reason."
    sentence = lines[-1]
    if sentence.startswith("error: "):
        sentence = sentence[len("error: "):]
    return sentence


def stream_job(handler: "Handler", name: str, body: dict) -> None:
    # Validation and binary resolution happen before the stream starts, so
    # their failures are still error envelopes, not mid-stream events.
    argv = operation_argv(name, body)
    binary = spis_binary()

    handler.send_response(200)
    handler.send_header("Content-Type", "application/x-ndjson")
    handler.send_header("Cache-Control", "no-cache")
    handler.end_headers()

    def emit(document: dict) -> None:
        handler.wfile.write(json.dumps(document).encode("utf-8") + b"\n")
        handler.wfile.flush()

    with JOB_LOCK:
        process = subprocess.Popen(
            [str(binary), *argv],
            cwd=ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        events: queue.Queue = queue.Queue()

        def pump(stream, stream_name: str) -> None:
            for chunk in iter(stream.readline, b""):
                events.put((stream_name, chunk))
            events.put((stream_name, None))

        threads = [
            threading.Thread(target=pump, args=(process.stdout, "stdout"), daemon=True),
            threading.Thread(target=pump, args=(process.stderr, "stderr"), daemon=True),
        ]
        for thread in threads:
            thread.start()

        stderr_chunks: list[bytes] = []
        open_streams = 2
        while open_streams:
            stream_name, chunk = events.get()
            if chunk is None:
                open_streams -= 1
                continue
            if stream_name == "stderr":
                stderr_chunks.append(chunk)
            emit({"type": "log", "stream": stream_name,
                  "chunk": chunk.decode("utf-8", "replace")})

        status = process.wait()
        for thread in threads:
            thread.join()

    if status == 0:
        result: dict = {"type": "result", "status": 0, "json": {}}
    else:
        sentence = refusal_sentence(b"".join(stderr_chunks).decode("utf-8", "replace"))
        result = {"type": "result", "status": status, "json": {"error": sentence}}
    emit(result)


class Handler(BaseHTTPRequestHandler):
    server_version = "SpisServe/1.0"

    def log_message(self, *args) -> None:  # keep stderr protocol-clean
        pass

    def send_document(self, status: int, document: dict) -> None:
        payload = json.dumps(document, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def send_failure(self, error: ServeError) -> None:
        self.send_document(error.status, {"error": str(error)})

    def read_body(self) -> dict:
        length = int(self.headers.get("Content-Length") or 0)
        if length > MAX_BODY_BYTES:
            raise bad_request("request body too large")
        raw = self.rfile.read(length) if length else b""
        if not raw.strip():
            return {}
        try:
            body = json.loads(raw)
        except ValueError:
            raise bad_request("request body is not valid JSON")
        if not isinstance(body, dict):
            raise bad_request("request body must be a JSON object")
        return body

    def do_GET(self) -> None:
        if self.path == "/v1/health":
            self.send_document(200, {"status": "ok"})
        else:
            self.send_failure(ServeError(404, f"unknown endpoint: GET {self.path}"))

    def do_POST(self) -> None:
        try:
            if not self.path.startswith("/v1/"):
                raise ServeError(404, f"unknown endpoint: POST {self.path}")
            name = self.path[len("/v1/"):]
            if not name or "/" in name:
                raise ServeError(404, f"unknown endpoint: POST {self.path}")
            body = self.read_body()
            stream_job(self, name, body)
        except ServeError as error:
            self.send_failure(error)
        except BrokenPipeError:
            pass  # the app walked away mid-stream
        except Exception as error:  # never leak a stack trace into a response
            try:
                self.send_failure(ServeError(500, str(error)))
            except BrokenPipeError:
                pass


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="spis-serve",
        description="Loopback HTTP/JSON backend for the Spis desktop app.",
    )
    parser.add_argument("--port", type=int, default=8080,
                        help="port to bind on 127.0.0.1 (0 picks an ephemeral port)")
    args = parser.parse_args()

    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    bound = server.server_address[1]
    sys.stdout.write(json.dumps({"ready": True, "port": bound}) + "\n")
    sys.stdout.flush()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
