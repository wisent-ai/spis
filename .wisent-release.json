{
  "schema_version": 1,
  "product": "spis",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--all",
            "--",
            "--check"
          ],
          "kind": "format"
        }
      ],
      "build": {
        "argv": [
          "stado",
          "product",
          "cargo",
          "stage",
          "--bin",
          "spis"
        ]
      },
      "stage": {
        "spis": "bin/spis"
      },
      "tests": [
        {
          "name": "catalog-type-lifecycle",
          "argv": [
            "stado",
            "product",
            "cargo",
            "test",
            "--",
            "--test",
            "catalog-type-lifecycle"
          ]
        },
        {
          "name": "capture-widths-refusals",
          "argv": [
            "stado",
            "product",
            "cargo",
            "test",
            "--",
            "--test",
            "capture-widths-refusals"
          ]
        }
      ]
    }
  },
  "promotion": {
    "channels": [
      "stable"
    ],
    "reconcile": false
  },
  "inputs": {
    "private-cargo-sources": {
      "uri": "stado://sources/spis/dependencies/private-cargo-sources/sha256/c0b4a4e909224ba66613fda19bbcd2d27bc4849c18e189fab101501cca3e7fc9/source.tar.gz",
      "sha256": "c0b4a4e909224ba66613fda19bbcd2d27bc4849c18e189fab101501cca3e7fc9",
      "mount": "private-cargo-sources",
      "extract": true
    }
  },
  "deliveries": []
}
