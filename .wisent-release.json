{
  "schema_version": 1,
  "product": "spis",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [],
      "build": {
        "argv": ["stado", "product", "cargo", "stage", "--bin", "spis"]
      },
      "tests": [
        {"name": "crawl", "argv": ["cargo", "test", "--locked", "--test", "crawl_host_resolved_executable"]}
      ],
      "stage": {
        "spis": "bin/spis"
      }
    }
  },
  "promotion": {
    "channels": ["stable"],
    "reconcile": false
  },
  "inputs": {},
  "deliveries": []
}
